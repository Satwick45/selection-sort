#include <stdio.h>

int set[10], x[10];
int n, target;

// Function to find subsets
void subset(int sum, int k) {
    int i;

    if(sum == target) {
        printf("Subset: ");
        for(i = 0; i < k; i++) {
            if(x[i] == 1)
                printf("%d ", set[i]);
        }
        printf("\n");
        return;
    }

    if(k == n || sum > target)
        return;

    // Include current element
    x[k] = 1;
    subset(sum + set[k], k + 1);

    // Exclude current element
    x[k] = 0;
    subset(sum, k + 1);
}

int main() {
    int i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &set[i]);
    }

    printf("Enter target sum: ");
    scanf("%d", &target);

    subset(0, 0);

    return 0;
}
