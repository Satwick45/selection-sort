V = 5

graph = [[0,2,0,6,0],
         [2,0,3,8,5],
         [0,3,0,0,7],
         [6,8,0,0,9],
         [0,5,7,9,0]]

selected = [0,0,0,0,0]
selected[0] = 1
edges = 0

print("Edge : Weight")

while edges < V-1:
    minimum = 999
    x = 0
    y = 0

    for i in range(V):
        if selected[i] == 1:
            for j in range(V):
                if selected[j] == 0 and graph[i][j] != 0:
                    if minimum > graph[i][j]:
                        minimum = graph[i][j]
                        x = i
                        y = j

    print(x,"-",y,":",graph[x][y])
    selected[y] = 1
    edges += 1
